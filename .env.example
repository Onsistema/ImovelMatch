# .env.example
# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-queries

# Table and Column to check (defaults to 'users' and 'email')
SUPABASE_TABLE_NAME=users
SUPABASE_EMAIL_COLUMN=email

# Redirection URLs
REDIRECT_REGISTRATION_URL=https://app.swaphome.com.br/
REDIRECT_CHECKOUT_URL=https://app.swaphome.com.br/checkout
